# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Drive Configuration
GDRIVE_PARENT_FOLDER_ID=your_gdrive_parent_folder_id_here
# Either raw stringified JSON or path to service_account.json
GDRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@your-project.iam.gserviceaccount.com"}

# Server Keep-Alive & Health Check
PORT=8080

# Media Optimization Settings
MAX_VIDEO_HEIGHT=720
WEBP_QUALITY=80
